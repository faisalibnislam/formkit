{
  "label": "Formkit API key",
  "parameters": [
    {
      "name": "apiKey",
      "type": "password",
      "label": "API key",
      "help": "Make one in Formkit under Settings → Developers, with Read your forms and Read responses ticked. It starts fk_live_.",
      "required": true
    }
  ],
  "communication": {
    "url": "https://formkit.app/api/v2/me",
    "headers": { "Authorization": "Bearer {{parameters.apiKey}}" },
    "response": {
      "metadata": { "type": "text", "value": "{{body.email}}" },
      "error": { "message": "[{{statusCode}}] {{body.error.message}}" }
    }
  }
}
